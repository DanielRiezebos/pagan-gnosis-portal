{% extends 'base.html.twig' %}
{% block content %}
<style>
    #intro-content {
        display: flex;
        align-items: center;
    }

    #intro-content img {
        height: auto;
        display: block;
    }
</style>
<div class="main-content">
        <div class="row list-title-row">
            <h1 class="list-title-name">Welcome to the PaganGnosisPortal!</h1>
        </div>
        <div class="row">
                <div class="card" style="padding: 3%;font-size: 110%;margin-bottom: 1%;">
                        <div id="intro-content">
                                <div class="card-content" style="width: 200%;">
                                        {{ introText | raw }}
                                </div>
                                <div>
                                        <img src="{{ asset('images/hometree.png') }}" alt="Welcome!"/>
                                </div>
                        </div>
                </div>                
        </div>
</div>
{% endblock %}
{% extends 'base.html.twig' %}
{% block content %}
<script>
    function confirmGnosisProjectDeletion(event) {
        if (!confirm("Are you sure you want to delete this project? This action cannot be undone.")) {
            event.preventDefault();
        }
    }

    // TODO: Zoek even wat slims voor dit GET variabel gedoe 
    function applyFilterByTags() {
        var checkedTags = document.querySelectorAll('input[name=gnosis_project_tag_box]:checked');
        var getVariables = "";
        for (var i = 0; i < checkedTags.length; i++) {
            if (getVariables.length < 1) {
                getVariables = "?tags[]=" + checkedTags[i].dataset.label;
            } else {
                getVariables = getVariables + "&tags[]=" + checkedTags[i].dataset.label;
            }
            
        }

        window.location.href = window.location.origin + window.location.pathname + getVariables;
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        let currentTagsFromUrl = new URLSearchParams(window.location.search).getAll('tags[]');
        let allTags = document.querySelectorAll('input[name=gnosis_project_tag_box]');

        for(var i = 0; i < allTags.length; i++) {
            if ( currentTagsFromUrl.includes(allTags[i].dataset.label)) {
                allTags[i].checked = true;
            }
        }
    });
</script>
<style>
    .gnosis-project-1 {
        background-color: #c2a77c;
    }
    .gnosis-projects-box {
        display: flex;
        flex-wrap: wrap;
    }
    .gnosis-project-card {
        padding: 1%;
        margin: 1%;
    }
    .gnosis-project-controls {
        display: flex;
        justify-content: space-between;
    }
</style>
<div class="main-content">
    <div class="row list-title-row">
        <h1 class="list-title-name">All Gnosis-Projects</h1>
        {% if is_granted('ROLE_ADMINISTRATOR') %}
            <button class="list-title-button primarybtn btn-lg btn-primary btn">
                <a href="/new/gnosis/project" style="color: white; font-size: 1.1em;">
                <b>+</b> Gnosis-Project
                </a>
            </button>
        {% endif %}
    </div>
    <div class="row">
        <div class="card card-content">
            <div class="col" id="tags">
                <h2>Filter by Tag</h2>
                <div class="gnosis_project_tags_container">
                    {% for tag in tags %}
                        <div class="gnosis_project_tag" onClick="applyFilterByTags()">
                            <input type="checkbox" id="gnosis_project_Tags_{{tag.id}}" name="gnosis_project_tag_box" class="gnosis-project-tag-input" value="{{ tag.id }}" data-label="{{tag.label}}">
                            <label class="gnosis-project-tag-label" for="gnosis_project_Tags_{{tag.id}}"><b>{{tag.label}}</b></label>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <hr />
            <div class="gnosis-projects-box">
                {% for gnosis_project in gnosis_projects %}
                    <div class="card gnosis-project-card gnosis-project-{{ gnosis_project.isClosed }}">
                        <div style="text-align: center"><h3>{{ gnosis_project.title }}</h3></div>
                        <div class="gnosis-project-dates">
                            <b>Start:</b> {{ gnosis_project.createdAt|date("m/d/Y") }}
                            <b>End:</b> {{ gnosis_project.finishedAt|date("m/d/Y") }}
                        </div>
                        <hr>
                        <div class="gnosis-project-controls">
                            {% if is_granted('ROLE_ADMINISTRATOR') %}
                                <a href="/update/gnosis/project/{{ gnosis_project.id }}">{{ include("assets/pencil.html.twig") }}</a>
                                <a href="/delete/gnosis/project/{{ gnosis_project.id }}" onClick="return confirmGnosisProjectDeletion(event)">{{ include("assets/trashcan.html.twig") }}</a>
                            {% endif %}
                            {% if gnosis_project.isClosed %}                
                                <a href="/results/gnosis/project/{{ gnosis_project.id }}">{{ include("assets/results.html.twig") }}</a>
                            {% else %}
                                <a href="/create/gnosis/project/entry/{{ gnosis_project.id }}">{{ include("assets/notepad.html.twig") }}</a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
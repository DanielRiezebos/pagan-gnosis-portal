<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>PaganGnosisPortal</title>
        
        {% block stylesheets %}
        <link href="{{ asset('css/fylgja.css') }}" rel="stylesheet">
        <style>            
            body {
                background-color: #e6c083;
                color: #201d17;                
            }
            .login-container {
                display: flex;
                height: 100vh;
            }
            .login-part {
                display: flex;
                width: 75%;
            }
            .login-part .login-form {
                margin: auto;
                width: 80%;
            }
            .login-part .logincard {
                background: #f9dfb7;
            }
            .login-part .login-form .introduction {
                font-size: 180%;
            }
            .image-part {
                flex-grow: 1; /* Takes remaining space */
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden; /* Prevents unwanted overflow */
            }
            .image-part img {
                width: 100%;
                height: 100%;
                object-fit: cover; /* Ensures the image covers the entire right section */
            }
        </style>
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body>
        <div class="login-container">
            <div class="login-part">
                <div class="login-form">
                    <div class="introduction">
                        <h3>You can register here below!</h3>
                    </div>
                    {# templates/base.html.twig or in your success page #}
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="flash-message flash-{{ label }}">
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}
                    <form method="POST" action="{{ path('post_registration') }}">
                        {# {% if error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %} #}
    
                        <div class="card card-content logincard">
                            <p class="">Please be considerate with your chosen username.</p>
                            <label for="username">Username</label>
                            <input type="text" style="background: white;" name="_username" id="username" class="form-control" autocomplete="username" required autofocus>
                            <label for="password">Password</label>
                            <input type="password" style="background: white;" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                            <label for="repeat-password">Repeat password</label>
                            <input type="password" style="background: white;" name="_repeat-password" id="repeat-password" class="form-control" autocomplete="repeat-password" required>

                            <input type="hidden" name="_csrf_token"
                                   value="{{ csrf_token('authenticate') }}"
                            >    
                            <button class="btn btn-lg btn-primary btn -outline" type="submit" style="width: 130px;margin-top: 10px; background: #e6c083">
                                Register now
                            </button>
                        </div>
                        <a href="/login">Back to login</a>
                    </form>
                </div>
            </div>
            <div class="image-part"><img src="{{ asset('images/registrationwood.jpg') }}" alt="Summer tree in the forest"></div>
        </div>
    </body>
</html>
{% extends 'base.html.twig' %}
{% block content %}
<style>
    .gnosis-entries-table {
        width: 100%;
    }
    .gnosis-entries-table textarea {
        color: red;
    }
    #editModal {
        width: 75%; !important;
        height: 75%;
    }
    #editModal textarea {
        height: 100%;
    }
    #editModal::backdrop {
        background-color: rgba(111, 106, 76, 0.5);
    }
</style>
<script>
    function confirmGnosisEntryDeletion(event) {
        if (!confirm("Are you sure you want to delete this entry? This action cannot be undone.")) {
            // Prevent navigation if the user clicks "NO"
            event.preventDefault();
        }
    }

    function beginEditExistingGnosis(gnosisEntryId) {
        const modal = document.getElementById('editModal');
        const editGnosis = document.getElementById('editGnosis');
        const editModalGnosisId = document.getElementById('editModalGnosisId');
        const gnosisEntryToEdit = document.getElementById(gnosisEntryId).innerHTML;
        
        editModalGnosisId.value = gnosisEntryId;
        editGnosis.value = gnosisEntryToEdit;
        modal.showModal();
    }

    function completeEditExistingGnosis() {
        const editGnosis = document.getElementById('editGnosis').value;
        const gnosisId = document.getElementById('editModalGnosisId').value.replace('gnosis_entry_', '');

        fetch('/update/gnosis/entry/' + gnosisId, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({ content:editGnosis, gnosis_id:gnosisId }),
        }).then(response => response.json())
        .then(data => {
            if (data.error) {
                alert(data.error);
            } else {
                location.reload();
            }
        })
        .catch(error => console.error('Error:', error));

        document.getElementById('editModal').close();
        setTimeout(location.reload(), 2345);
    }
</script>
<dialog id="editModal">
    <input type="hidden" id="editModalGnosisId" />
    <h3>Edit your Gnosis</h3>
    <textarea id="editGnosis"></textarea>
    <div class="col">
        <button type="submit" class="form-confirm-button primarybtn btn-lg btn-primary btn" onClick="completeEditExistingGnosis()">Save Gnosis</button>
        <button type="button" onClick="document.getElementById('editModal').close()" class="form-cancel-button primarybtn btn-lg btn-primary btn">Cancel</button>
    </div>
</dialog>
<div class="main-content">
    <div class="row list-title-row">
        <h1 class="list-title-name">Add a new Gnosis Entry</h1>    
    </div>
    <div class="row" style="margin: 1%;">
        <div class="card card-content">
            <h2>What can we tell you about <b>{{gnosisProject.title}}</b>?</h2>
            <p>{{ gnosisProject.description|nl2br|raw }}</p>
        </div>
    </div>
    <div class="row">
    {{ form_start(form) }}
        <div class="card card-content">
            <div class="errors">
                {{ form_errors(form) }}
            </div>

            <div class="row">
                {% if currentEntries|length > 0 %}
                    <h2>These are your current recorded experiences:</h2>
                    <table class="gnosis-entries-table">
                        <th>Date</th>
                        <th>Gnosis</th>
                        <th><!-- Empty table header for    a e s t h e t i c    reasons --></th>
                        <th><!-- Empty table header for    a e s t h e t i c    reasons --></th>
                        {% for currentEntry in currentEntries %}            
                            <tr>
                                <td>{{ currentEntry.createdAt|date('Y-m-d') }}: </td>
                                <td id="gnosis_entry_{{currentEntry.id}}">{{ currentEntry.gnosis }}</td>
                                <td><a href="/delete/gnosis/project/entry/{{ currentEntry.id }}" onClick="return confirmGnosisEntryDeletion(event)">{{ include("assets/trashcan.html.twig") }}</a></td>
                                <td><a href="#" onClick="return beginEditExistingGnosis('gnosis_entry_{{currentEntry.id}}')">{{ include("assets/pencil.html.twig") }}</a></td>
                            </tr>
                        {% endfor %}
                    </table>
                {% else %}
                    <h2>You have no experiences recorded so far.</h2>
                {% endif %}
            </div>

            <div class="row">
                <h2>What would you like to add?</h2>
                <div class="col" id="gnosis">
                    {{ form_row(form.gnosis) }}
                </div>
            </div>
            <button type="submit" class="form-confirm-button primarybtn btn-lg btn-primary btn" id="gnosis-entry-action">Save New Entry</button>
        </div>
    {{ form_end(form) }}
    </div>
</div>
{% endblock %}
